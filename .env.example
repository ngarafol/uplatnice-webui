# Kopiraj u .env (i ne commitaj .env).

# Obavezno: potpisuje session cookie. Bez njega server u produkciji neće ni
# pokrenuti se. Generiraj npr. s:  openssl rand -hex 32
SESSION_SECRET=promijeni-me-na-slucajni-string

# true = cookie se šalje SAMO preko HTTPS.
# Postavi na false jedino ako serviraš preko običnog HTTP-a (lokalno/LAN),
# inače se ne možeš prijaviti jer preglednik ne pošalje cookie.
SECURE_COOKIES=false

# Ako je postavljen, registracija traži taj kod (invite-only). Prazno = svatko se
# može registrirati.
REGISTRATION_CODE=

# Dnevne kopije baze: kam idu i koliko se čuva. Prazno = data/backups uz bazu.
BACKUP_DIR=
BACKUP_KEEP=14
